# Configuración de la base de datos PostgreSQL
# Formato: postgresql+asyncpg://usuario:contraseña@host:puerto/base_de_datos
DATABASE_URL=postgresql+asyncpg://localhost:5432/jurisprudencia

# Directorio para almacenar archivos PDF subidos
UPLOAD_DIR=./uploads

# Directorio para persistencia de ChromaDB
PERSIST_DIR=./chroma_db
